        if ctermbg is not None:
            options.append(f"ctermbg={ctermbg}")
        if attributes:
            options.extend((f"gui={attributes}", f"cterm={attributes}"))
        lines.append(f"highlight {name} " + " ".join(options))
    return "\n".join(lines) + "\n"


def atomic_write_many(files: dict[Path, str]) -> list[Path]:
    """Prepare every file first, then atomically replace each destination."""
    prepared: list[tuple[Path, Path]] = []
    changed: list[Path] = []
    try:
        for destination, text in files.items():
            destination.parent.mkdir(parents=True, exist_ok=True)
            encoded = text.encode("utf-8")
            if destination.exists() and destination.read_bytes() == encoded:
                continue
            fd, temp_name = tempfile.mkstemp(prefix=f".{destination.name}.", suffix=".tmp", dir=destination.parent)
            temp = Path(temp_name)
            with os.fdopen(fd, "wb") as stream:
                stream.write(encoded)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temp, 0o644)
            prepared.append((temp, destination))
        for temp, destination in prepared:
            os.replace(temp, destination)
            changed.append(destination)
        for parent in {path.parent for path in changed}:
            fd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        return changed
    finally:
        for temp, _ in prepared:
            temp.unlink(missing_ok=True)


def safe_scene_id(value: object) -> str:
    if not isinstance(value, str) or not value or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for c in value):
        raise ValueError("Worldwall returned an invalid scene identifier")
    return value


def library_root_for(config: dict) -> Path | None:
    sidecar_setting = config.get("scene_pools_file")
    if not sidecar_setting:
        return None
    sidecar = Path(str(sidecar_setting)).expanduser()
    if not sidecar.is_absolute():
        raise ValueError("Worldwall scene_pools_file must be an absolute path")
    sidecar = sidecar.resolve(strict=True)
    adjacent_catalog = sidecar.parent / "library.toml"
    if adjacent_catalog.is_file():
        return sidecar.parent.resolve(strict=True)
    data_home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    if not data_home.is_absolute():
        data_home = HOME / ".local/share"
    return (data_home / "worldwall/scene-library").resolve(strict=True)


def resolve_scene_package(scene_id: str, config: dict) -> Path:
    """Resolve a resident package from either configured registry or S12 library."""
    registry_setting = config.get("registry_dir")
    if registry_setting and str(registry_setting).lower() != "none":
        registry = Path(str(registry_setting)).expanduser()
        if not registry.is_absolute():
            registry = (WW_CONFIG.parent / registry).resolve()
        registry = registry.resolve(strict=True)
        registry_doc = tomllib.loads((registry / "registry.toml").read_text(encoding="utf-8"))
        if scene_id in registry_doc.get("scenes", []):
            package = (registry / scene_id).resolve(strict=True)
            if package.parent != registry or not package.is_dir():
                raise ValueError("active scene package path is not a direct registry child")
            return package

    library = library_root_for(config)
    if library is not None:
        catalog = tomllib.loads((library / "library.toml").read_text(encoding="utf-8"))
        entries = catalog.get("scene", [])
        if not isinstance(entries, list):
            raise ValueError("library catalog scene entries must be an array")
        entry = next((row for row in entries if isinstance(row, dict) and row.get("id") == scene_id), None)
        if entry is not None:
            package_name = entry.get("package")
            safe_name = (
                isinstance(package_name, str)
                and bool(package_name)
                and package_name not in (".", "..")
                and package_name[0].isascii()
                and package_name[0].isalnum()
                and all(char.isascii() and (char.isalnum() or char in "._-") for char in package_name)
            )
            if not safe_name:
                raise ValueError(f"library catalog has an unsafe package path for {scene_id}")
            package = (library / package_name).resolve(strict=True)
            if package.parent != library or not package.is_dir():
                raise ValueError("active library package path is not a direct catalog child")
            return package
    raise ValueError(f"active scene is not listed in configured registry or library: {scene_id}")


def read_worldwall_state() -> tuple[dict, dict, Path, str]:
    if not WW_CONFIG.is_file():
        raise ValueError(f"Worldwall config is unavailable: {WW_CONFIG}")
    config = tomllib.loads(WW_CONFIG.read_text(encoding="utf-8"))
    status_result = subprocess.run([str(WWCTL), "status"], check=True, capture_output=True, text=True, timeout=3)
    status = json.loads(status_result.stdout)
    if status.get("ok") is not True:
        raise ValueError("worldwallctl status returned an unsuccessful response")
    scene_id = safe_scene_id(status.get("data", {}).get("scene"))
    package = resolve_scene_package(scene_id, config)
    scene_doc = tomllib.loads(contained_file(package, "scene.toml").read_text(encoding="utf-8"))
    if scene_doc.get("id") != scene_id:
        raise ValueError("scene manifest ID does not match Worldwall status")
    return config, scene_doc, package, scene_id


def compute_current_theme() -> tuple[str, dict[str, str], str]:
    config, scene_doc, package, scene_id = read_worldwall_state()
    palette, source = load_effective_palette(package, scene_doc, config)
    counts, total = scene_histogram(package, scene_doc)
    bar_height = waybar_top_height()
    waybar_counts, waybar_total = waybar_area_histogram(
        package, scene_doc, waybar_output_geometries(bar_height)
    )
    theme = build_theme(palette, counts, total, waybar_counts, waybar_total)
    return scene_id, theme, source


def reload_waybar() -> None:
    try:
        result = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "waybar"], capture_output=True, text=True, timeout=2)
        for line in result.stdout.splitlines():
            try:
                # Waybar defaults SIGUSR1 to visibility toggle and SIGUSR2 to reload.
                os.kill(int(line), signal.SIGUSR2)
            except (ValueError, ProcessLookupError, PermissionError):
                continue
    except (OSError, subprocess.TimeoutExpired):
        pass


def update_hyprland_border(theme: dict[str, str]) -> None:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    accent = hex_rgb(theme["accent"])
    surface = hex_rgb(theme["background"])
    # Keep the frame in the scene's accent family but tone it down against the
    # wallpaper and terminal text; this replaces the old cyan/green gradient.
    border = quantize(mix(accent, surface, 0.40))
    color = f"rgba({rgb_hex(border)[1:]}bb)"
    try:
        command = f'hl.config({{ ["general.col.active_border"] = "{color}" }})'
        result = subprocess.run(
            ["hyprctl", "eval", command],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if result.returncode != 0:
            log(f"Hyprland border update failed: {result.stderr.strip() or result.stdout.strip()}")
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"Hyprland border update failed: {exc}")


def update_alacritty_runtime(theme: dict[str, str]) -> None:
    binary = "alacritty"
    runtime_sockets = sorted(RUNTIME_HOME.glob("Alacritty-*.sock"))
    values = [
        f"colors.primary.background={json.dumps(theme['background'])}",
        f"colors.primary.foreground={json.dumps(theme['foreground'])}",
        f"colors.cursor.text={json.dumps(theme['foreground'])}",
        f"colors.cursor.cursor={json.dumps(theme['cursor'])}",
        f"colors.selection.text={json.dumps(theme['foreground'])}",
        f"colors.selection.background={json.dumps(theme['selection'])}",
        f"colors.normal.black={json.dumps(theme['background'])}",
        f"colors.normal.red={json.dumps(theme['ansi_red'])}",
        f"colors.normal.green={json.dumps(theme['ansi_green'])}",
        f"colors.normal.yellow={json.dumps(theme['ansi_yellow'])}",
        f"colors.normal.blue={json.dumps(theme['secondary'])}",
        f"colors.normal.magenta={json.dumps(theme['ansi_magenta'])}",
        f"colors.normal.cyan={json.dumps(theme['accent'])}",
        f"colors.normal.white={json.dumps(theme['ansi_white'])}",
        f"colors.bright.black={json.dumps(theme['ansi_bright_black'])}",
        f"colors.bright.red={json.dumps(theme['ansi_bright_red'])}",
        f"colors.bright.green={json.dumps(theme['ansi_bright_green'])}",
        f"colors.bright.yellow={json.dumps(theme['ansi_bright_yellow'])}",
        f"colors.bright.blue={json.dumps(theme['bright_secondary'])}",
        f"colors.bright.magenta={json.dumps(theme['ansi_bright_magenta'])}",
        f"colors.bright.cyan={json.dumps(theme['bright_accent'])}",
        f"colors.bright.white={json.dumps(theme['ansi_bright_white'])}",
    ]
    for socket_path in runtime_sockets:
        try:
            info = socket_path.stat()
            if info.st_uid != os.getuid():
                continue
            subprocess.run(
                [binary, "msg", "--socket", str(socket_path), "config", "-w", "-1", *values],
                check=True, capture_output=True, text=True, timeout=3,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"Alacritty runtime update failed for {socket_path.name}: {exc}")


def update_vim_runtime() -> None:
    try:
        servers = subprocess.run(["vim", "--serverlist"], capture_output=True, text=True, timeout=2)
        if servers.returncode != 0:
            return
        for server in servers.stdout.split():
            subprocess.run(
                ["vim", "--servername", server, "--remote-expr", 'execute("colorscheme worldwall")'],
                check=True,
                capture_output=True,
                text=True,
                timeout=3,
            )
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"Vim runtime update failed: {exc}")


def generated_theme_files(css_text: str, alacritty_text: str, vim_text: str) -> dict[Path, str]:
    files = {WAYBAR_THEME: css_text}
    if not TERMINAL_SYNC_DISABLED_FILE.exists():
        files[ALACRITTY_THEME] = alacritty_text
        files[VIM_THEME] = vim_text
    return files


def apply_once(
    dry_run: bool = False,
    no_reload: bool = False,
    force_reload: bool = False,
    quiet: bool = False,
    defer_waybar_reload: bool = False,
) -> tuple[str, dict[str, str], str, list[Path]]:
    scene_id, theme, source = compute_current_theme()
    css_text = render_waybar(theme)
    alacritty_text = render_alacritty(theme)
    vim_text = render_vim(theme)
    if not quiet:
        print(json.dumps({"scene": scene_id, "palette_source": source, "theme": theme}, indent=2))
    changed: list[Path] = []
    if not dry_run:
        terminal_sync_enabled = not TERMINAL_SYNC_DISABLED_FILE.exists()
        changed = atomic_write_many(generated_theme_files(css_text, alacritty_text, vim_text))
        if not no_reload:
            if (force_reload or WAYBAR_THEME in changed) and not defer_waybar_reload:
                reload_waybar()
            if terminal_sync_enabled:
                if force_reload or ALACRITTY_THEME in changed:
                    update_alacritty_runtime(theme)
                if force_reload or VIM_THEME in changed:
                    update_vim_runtime()
            update_hyprland_border(theme)
        mode = "enabled" if terminal_sync_enabled else "paused"
        log(f"scene={scene_id} source={source} terminal_sync={mode} changed={','.join(str(p) for p in changed) or 'none'}")
    return scene_id, theme, source, changed


stop_requested = False


def request_stop(_signum, _frame) -> None:
    global stop_requested
    stop_requested = True


def process_start_time(pid: int) -> str | None:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").rsplit(")", 1)[1].split()
        return fields[19]
    except (OSError, IndexError):
        return None


def run_watcher(supervisor_pid: int | None = None) -> int:
    supervisor_start = process_start_time(supervisor_pid) if supervisor_pid is not None else None
    if supervisor_pid is not None and supervisor_start is None:
        log(f"session supervisor PID {supervisor_pid} is unavailable; watcher not started")
        return 1
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE_DIR, 0o700)
    lock = LOCK_FILE.open("a+")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    PID_FILE.write_text(f"{os.getpid()}\n", encoding="ascii")
    os.chmod(PID_FILE, 0o600)
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    last_scene = None
    last_sample = 0.0
    waybar_reload_debouncer = WaybarReloadDebouncer(WAYBAR_RELOAD_DEBOUNCE_SECONDS)
    try:
        while not stop_requested:
            if (
                supervisor_pid is not None
                and process_start_time(supervisor_pid) != supervisor_start
            ):
                log(f"session supervisor PID {supervisor_pid} exited; stopping watcher")
                break
            try:
                # Status is cheap; re-read the palette only on scene changes or
                # at a deliberately coarse cadence for civil-time transitions.
                _config, _doc, _package, scene_id = read_worldwall_state()
                now = time.monotonic()
                if scene_id != last_scene or now - last_sample >= TIME_RESAMPLE_SECONDS:
                    # read_worldwall_state already confirmed a healthy active scene.
                    applied_scene, _theme, _source, changed = apply_once(
                        quiet=True, defer_waybar_reload=True
                    )
                    last_scene = applied_scene
                    last_sample = now
                    if WAYBAR_THEME in changed:
                        waybar_reload_debouncer.palette_changed(now)
            except Exception as exc:
                log(f"sync deferred: {type(exc).__name__}: {exc}")
                for _ in range(30):
                    if stop_requested:
                        break
                    time.sleep(1)
                continue
            if waybar_reload_debouncer.take_if_due(time.monotonic()):
                reload_waybar()
                log("Waybar reload dispatched after palette changes settled")
            for _ in range(POLL_SECONDS):
                if stop_requested:
                    break
                time.sleep(1)
    finally:
        try:
            if PID_FILE.read_text(encoding="ascii").strip() == str(os.getpid()):
                PID_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        lock.close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="apply one palette sample and exit")
    parser.add_argument("--dry-run", action="store_true", help="print the current derived theme without writing")
    parser.add_argument("--no-reload", action="store_true", help="write files without notifying running applications")
    parser.add_argument("--force-reload", action="store_true", help="notify running applications even when generated files already match")
    parser.add_argument(
        "--supervisor-pid",
        type=int,
        help="stop the watcher when this session process exits (for session-bound manual launches)",
    )
    args = parser.parse_args()
    if args.dry_run:
        apply_once(dry_run=True)
        return 0
    if args.once:
        STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = LOCK_FILE.open("a+")
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        try:
            apply_once(no_reload=args.no_reload, force_reload=args.force_reload)
        finally:
            lock.close()
        return 0
    return run_watcher(args.supervisor_pid)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, tomllib.TOMLDecodeError, subprocess.SubprocessError) as exc:
        log(f"fatal: {type(exc).__name__}: {exc}")
        print(f"worldwall-theme-watch: {exc}", file=sys.stderr)
        raise SystemExit(1)
